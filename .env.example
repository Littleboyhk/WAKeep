# =============================================================================
# WAKeep - Environment Configuration
# =============================================================================

# Server Port (Cloud providers like Render/Koyeb inject PORT automatically)
PORT=3000
NODE_ENV=production

# Supabase PostgreSQL Connection
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-supabase-project-id.supabase.co
# Use the 'service_role' secret key to bypass RLS policies safely from the backend server
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_token_here

# 32-Byte (256-bit) Encryption Key for AES-256-GCM Session Vault
# Generate using Node:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or using OpenSSL:
#   openssl rand -hex 32
VAULT_SECRET_KEY=e83b4f6a1c890d2e5a7b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f

# Admin Dashboard Access PIN (Required to unlock the Web Control Center)
ADMIN_PIN=4928

# JWT Signing Secret for Session Authentication Tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=super_secret_session_guard_token_seed_string_987654321

# Unique Session Identifier in Supabase Vault
SESSION_ID=main_session
